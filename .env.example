# NagrikSetu environment configuration
# Copy this file to .env and fill in your Supabase project values.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (Project Settings > API)
VITE_SUPABASE_ANON_KEY=

# Public site URL used for auth email redirects (login/verify/reset).
# In local dev this is typically http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# Default map centre + zoom (Leaflet / OpenStreetMap)
VITE_MAP_DEFAULT_LAT=19.0760
VITE_MAP_DEFAULT_LNG=72.8777
VITE_MAP_DEFAULT_ZOOM=12

# Client-side rate limit for complaint submissions (per rolling window)
VITE_RATE_LIMIT_MAX=5
VITE_RATE_LIMIT_WINDOW_MS=60000
